; Engine configuration file.
; Khaled Star Hero - educational 3D game (Godot 4.4)

config_version=5

[application]

config/name="Khaled Star Hero"
config/description="لعبة تعليمية ثلاثية الأبعاد لخالد: الحروف والأرقام بالعربية والإنجليزية"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.184, 0.525, 0.902, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=false
config/icon="res://assets/ui/icon_192.png"

[autoload]

GameData="*res://scripts/game_data.gd"
Narrator="*res://scripts/narrator.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/include_text_server_data=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
